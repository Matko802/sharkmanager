[Desktop Entry]
Name=SharkManager
GenericName=File Manager
Comment=Thunar-like file manager built with Rust + GTK4 🦈
Exec=sharkmanager %U
Icon=system-file-manager
Terminal=false
Type=Application
Categories=Utility;FileManager;GTK;
StartupNotify=true
Keywords=files;manager;thunar;gtk4;explorer;
MimeType=inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=sharkmanager
